# Free HTTPS certificate + secure WebSocket for the classroom.
{$LK_DOMAIN} {
	# Traffic report for the admin Usage page. Readable only with the shared token,
	# so the numbers are never public. Written every 5 minutes by ddd-usage.py.
	@usage path /usage.json
	handle @usage {
		@authorised header Authorization "Bearer {$LK_USAGE_TOKEN}"
		handle @authorised {
			root * /srv/ddd-usage
			file_server
		}
		handle {
			respond "unauthorized" 401
		}
	}

	# Course material: the files in /srv/ddd-material on this machine (mounted
	# at /srv/www/m), sent only when the address carries an unexpired signature
	# from the platform. ddd-material.py checks it; Caddy does the sending, with
	# byte ranges so audio can be skipped through.
	handle /m/* {
		forward_auth 127.0.0.1:7890 {
			uri /verify
		}
		root * /srv/www
		@download query dl=1
		header @download Content-Disposition attachment
		header X-Content-Type-Options nosniff
		file_server
	}

	# The list of files, uploads from the admin page, and deletions — all signed.
	handle /m-api/* {
		request_body {
			max_size 600MB
		}
		reverse_proxy 127.0.0.1:7890 {
			transport http {
				read_timeout 10m
				write_timeout 10m
			}
		}
	}

	handle {
		reverse_proxy 127.0.0.1:7880
	}
}
